{
  "name": "AAvisit Send Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aavisit-send",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "name": "Send Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "b7d2f1a4-3c58-4e1a-9f0e-5a6c1d2e8f10"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.agentboxd.com/v1/inboxes/YOUR_AGENTBOXD_INBOX_ID/messages/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_AGENTBOXD_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ to: $json.body.to, subject: $json.body.subject, text: $json.body.text, html: $json.body.html }) }}",
        "options": {}
      },
      "name": "Agentboxd Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        300
      ]
    }
  ],
  "connections": {
    "Send Webhook": {
      "main": [
        [
          {
            "node": "Agentboxd Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agentboxd Send": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}